# ===== EduNova · copia este archivo a ".env" y ajusta los valores =====
NODE_ENV=development
PORT=8080

# --- Base de datos: PostgreSQL (Supabase) ---
# Supabase > Connect > "Session pooler" (puerto 5432) para correr  npm run db:init  desde tu PC.
# En Vercel usa el "Transaction pooler" (puerto 6543).
DATABASE_URL=postgresql://postgres.TU_REF:TU_CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres
DB_SSL=true

# --- Archivos (boletines, consolidados, firmas, chat, fotos) ---
# Con SUPABASE_URL + SUPABASE_SECRET_KEY se guardan en Supabase Storage (bucket privado, se crea solo).
# Sin ellos se guardan en disco (STORAGE_DIR, por defecto backend/storage) — solo para desarrollo local.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=edunova
# Vercel limita el cuerpo de una petición a 4.5 MB
CHAT_MAX_MB=4

# --- Cron de Vercel (clave para /api/cron/daily; cualquier texto largo y secreto) ---
CRON_SECRET=

# --- Seguridad (obligatorio, mínimo 32 caracteres) ---
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Institución (aparece en correos, boletines y consolidados) ---
INSTITUTION_NAME=EduNova
INSTITUTION_ADDRESS=Calle 10 #20-30, Cartagena de Indias, Bolívar, Colombia
INSTITUTION_PHONE=+57 300 000 0000

# --- Correo / 2FA (opcional). Sin SMTP, el código 2FA se imprime en la consola del servidor ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Notificaciones push con Firebase (opcional) ---
FIREBASE_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_FILE=firebase-service-account.json

# --- Asistente de IA (opcional; vacío = desactivado) ---
AI_API_KEY=
AI_URL=
AI_MODEL=

# --- Contraseñas de las cuentas demo que crea "npm run db:init" ---
ADMIN_PASSWORD=EduNova2026*
TEACHER_PASSWORD=EduNova2026*

# --- PDF: usa Chromium (en Vercel viene incluido). En tu PC detecta Chrome/Edge; si no, define su ruta ---
# CHROME_PATH=

# --- Otros ---
# Detrás de un proxy pon TRUST_PROXY=true (en Vercel se activa solo)
TRUST_PROXY=false
# Orígenes del frontend, separados por coma. Sin "/" final ni ruta:
# ALLOWED_ORIGINS=https://ingemartin-dev.github.io
ALLOWED_ORIGINS=
