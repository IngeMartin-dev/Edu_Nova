# Copia este archivo a ".env" (en esta misma carpeta) y completa los valores.

# Dominio gratis de DuckDNS apuntando a la IP de tu servidor (sin https://)
DOMAIN=edunova.duckdns.org

# --- TiDB Cloud ---
DB_HOST=gateway01.xxxx.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=abc123.root
DB_PASSWORD=
DB_NAME=edu_nova
DB_SSL=true

# Genera uno con: openssl rand -hex 48
JWT_SECRET=

# Frontend en GitHub Pages (sin "/" final ni ruta)
ALLOWED_ORIGINS=https://ingemartin-dev.github.io

INSTITUTION_NAME=EduNova
